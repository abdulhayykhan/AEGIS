# ==============================================================================
# AEGIS Environment & Secrets Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://aegis:aegis_secure_password@localhost:5432/aegis
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_password

# Operations & Supervision (Telegram Bot API)
AEGIS_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AEGIS_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
AEGIS_TELEGRAM_USER_ID=your_telegram_user_id_here
AEGIS_HEARTBEAT_WEBHOOK_URL=https://healthchecks.example.com/ping/your-uuid

# Execution Mode: RECOMMEND_ONLY | PAPER_EXECUTION | LIVE_WITH_APPROVAL | FULL_AUTONOMY
AEGIS_EXECUTION_MODE=PAPER_EXECUTION

# Owner Security Perimeter: Separate Role-Specific Secrets (N4)
AEGIS_OWNER_NAME="Abdul Hayy Khan"
AEGIS_OWNER_SECRET=generate_master_cryptographic_secret_here
AEGIS_APPROVAL_SECRET=generate_order_signing_secret_here
AEGIS_KILL_SWITCH_SECRET=generate_kill_switch_disengage_secret_here
AEGIS_RESTORE_SECRET=generate_autonomy_restore_secret_here
AEGIS_FLATTEN_SECRET=generate_emergency_flatten_secret_here

# Live Exchange Broker Credentials (Trade-Only, Spot Only, Withdrawals Disabled)
EXCHANGE_API_KEY=your_trade_only_api_key_here
EXCHANGE_API_SECRET=your_trade_only_api_secret_here
EXCHANGE_TESTNET=true
